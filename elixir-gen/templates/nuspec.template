    <projectSourceUrl>https://github.com/elixir-lang/elixir</projectSourceUrl>
    <packageSourceUrl>https://github.com/chocolatey-beam/au-packages</packageSourceUrl>
    <releaseNotes>https://github.com/elixir-lang/elixir/releases</releaseNotes>
    <tags>elixir erlang programming language functional</tags>
