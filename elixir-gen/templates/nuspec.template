    <licenseUrl>https://github.com/elixir-lang/elixir/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <iconUrl>https://github.com/chocolatey-beam/au-packages/raw/main/@@PACKAGE_ID@@/elixir-icon.png</iconUrl>
    <docsUrl>https://hexdocs.pm/elixir/</docsUrl>
    <mailingListUrl>https://elixir-lang.org/community.html</mailingListUrl>
    <bugTrackerUrl>https://github.com/elixir-lang/elixir/issues</bugTrackerUrl>
