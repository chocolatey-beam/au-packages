<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>@@PACKAGE_ID@@</id>
    <title>@@TITLE@@</title>
    <version>0.0.0</version>
    <authors>José Valim</authors>
    <owners>Luke Bakken, Team RabbitMQ</owners>
